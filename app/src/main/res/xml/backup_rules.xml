<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and older (from Android 12 on, data_extraction_rules.xml applies).
    Wichtly deliberately backs up nothing (matching android:allowBackup="false" in the manifest):
    the database and photos stay on the device only.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
