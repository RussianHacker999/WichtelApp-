<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup-Regeln für Android 11 und älter (ab Android 12 gilt data_extraction_rules.xml).
    Wichtly sichert bewusst nichts (passend zu android:allowBackup="false" im Manifest):
    Datenbank und Fotos bleiben ausschließlich auf dem Gerät.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
