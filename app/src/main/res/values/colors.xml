<?xml version="1.0" encoding="utf-8"?>
<!--
    Only colors that Android reads before Compose runs (launcher icon, splash screen, window).
    All app colors live in ui/theme/Color.kt; do not add Compose colors here.
-->
<resources>
    <!-- Cream from the app logo -->
    <color name="ic_launcher_background">#FFFBF5E8</color>
    <color name="splash_background">@color/ic_launcher_background</color>

    <!-- Same as Pine900 in Color.kt, avoids a white flash before Compose draws -->
    <color name="window_background">#FF0E2A22</color>
</resources>
