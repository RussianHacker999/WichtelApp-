<?xml version="1.0" encoding="utf-8"?>
<!--
    Only colours that Android reads before Compose runs (launcher icon, splash screen, window).
    All app colours live in ui/theme/Color.kt; do not add Compose colours here.
-->
<resources>
    <!-- Cream white from the app logo -->
    <color name="ic_launcher_background">#FFFBF5E8</color>
    <color name="splash_background">@color/ic_launcher_background</color>

    <!-- Same as Pine900 in Color.kt; prevents a white flash before Compose draws -->
    <color name="window_background">#FF0E2A22</color>
</resources>
