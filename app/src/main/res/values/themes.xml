<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Wichtly" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash screen at app start (androidx.core:core-splashscreen; covers all supported versions from API 26 on). -->
    <style name="Theme.Wichtly.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Wichtly</item>
    </style>
</resources>
